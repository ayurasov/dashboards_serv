# Скопируйте в .env и заполните перед запуском: cp .env.example .env
# Подробности — docs/manuals/deployment-guide.md

# Порт приложения на сервере
APP_PORT=8000

# Ключ подписи — обязательно свой: openssl rand -hex 32
SECRET_KEY=change-me

# PostgreSQL (контейнер db из docker-compose.yml)
POSTGRES_DB=dashboards
POSTGRES_USER=dashboards
POSTGRES_PASSWORD=change-me-too

# Первичный администратор создаётся, если пользователей нет.
# Пустой ADMIN_PASSWORD — временный пароль будет выведен в журнал контейнера (docker compose logs app).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Демонстрационные данные (пользователи и данные служб) — только для стенда
DEMO_DATA=false

# Часовой пояс компании: границы дней в журнале изменений, время в PDF-отчётах
TIMEZONE=Europe/Moscow

# Вход по учётной записи домена (LDAP / Active Directory). Сначала проверьте настройку
# на странице «Администрирование → Вход по домену» с AUTH_LDAP_ENABLED=false, затем включите.
# Остальные AUTH_LDAP_* и AD_SYNC_* — в docker-compose.override.yml (docs/manuals/deployment-guide.md).
# AUTH_LDAP_ENABLED=false
# AUTH_LDAP_URL=ldaps://dc.company.local:636
# AUTH_LDAP_BASE_DN=DC=company,DC=local
# AUTH_LDAP_BIND_DN=CN=svc-dashboards,OU=Service,DC=company,DC=local
# AUTH_LDAP_BIND_PASSWORD=

# За HTTPS-прокси включите защищённые cookie
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=12

# Производительность: число процессов (пусто — 2 × ядра + 1) и пул соединений на процесс
WEB_CONCURRENCY=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=4
# Очередь к базе: дольше DB_QUEUE_TIMEOUT секунд — ответ 503 «Сервер перегружен»
DB_QUEUE_TIMEOUT=30
# PDF-отчётов, одновременно строящихся в процессе
PDF_CONCURRENCY=2

# Журнал в JSON для систем сбора логов
LOG_JSON=false

# CORS нужен, только если интерфейс открывается с другого адреса
CORS_ORIGINS=

# Адрес, по которому пользователи открывают «Дашборды» (http(s)://узел[:порт][/путь], без «/» в конце): ссылки
# со страницы сквозного отчёта в Confluence и из комментария в задаче «По Делу». Пусто — без ссылок.
# PUBLIC_URL=https://dashboards.company.ru

# Входящие данные (ADR-0011). В Docker папка «Входящие» — том inbox (/data/inbox), общий для app и worker;
# пустой INBOX_DIR вне Docker — папка не опрашивается. Файл берётся, когда не меняется INBOX_SETTLE_SECONDS.
# INBOX_DIR=/data/inbox
# INBOX_SETTLE_SECONDS=10
# INBOX_MAX_MB=20
# Сколько дней хранить исходные файлы обработанных элементов (в базе и в processed/, rejected/)
# INBOX_RETENTION_DAYS=90
# Приём по API (/api/inbound/v1): запросов в минуту на ключ
# INBOUND_RATE_LIMIT=120

# Подключения к корпоративным системам: прокси и разрешённые узлы (через запятую; «.company.ru» — домен
# и поддомены; пусто — любые). Секреты подключений шифруются ключом из SECRET_KEY: после смены
# SECRET_KEY их нужно ввести заново.
# HTTP_PROXY — для адресов http://, HTTPS_PROXY — для https://; IMAP почтового ящика ходит напрямую.
# HTTP_PROXY=http://proxy.company.local:3128
# HTTPS_PROXY=http://proxy.company.local:3128
# NO_PROXY=localhost,127.0.0.1,.company.local
# PODELU_ALLOWED_HOSTS=
# PULS_ALLOWED_HOSTS=
# JIRA_ALLOWED_HOSTS=.company.ru
# CONFLUENCE_ALLOWED_HOSTS=.company.ru
# BITRIX24_ALLOWED_HOSTS=
# EXCHANGE_ALLOWED_HOSTS=
# ONEC_ALLOWED_HOSTS=
