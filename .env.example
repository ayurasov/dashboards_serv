# Copy to .env and fill in production values before running:
#   cp .env.example .env

# Port exposed on the host (default: 8000)
APP_PORT=8000

# JWT secret — MUST be changed in production (min 32 random chars)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: use * for dev; restrict to your domain in production
# e.g. CORS_ORIGINS=https://dashboards.example.com
CORS_ORIGINS=*
